# ─── CineSphere Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
#
# Required secrets:
#
# TMDB_API_KEY
#   Your TMDB API Read Access Token (JWT Bearer Token).
#   Get it at: https://www.themoviedb.org/settings/api
#
# GEMINI_API_KEY
#   Your Google Gemini API key.
#   Get it at: https://aistudio.google.com/app/apikey
#
# GOOGLE_SERVER_CLIENT_ID
#   The Web Client ID from your Firebase project.
#   Find it at: Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration

TMDB_API_KEY=your_tmdb_api_read_access_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SERVER_CLIENT_ID=your_google_server_client_id_here
